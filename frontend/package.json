{
  "name": "frame-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "build": "bun ./node_modules/vite/bin/vite.js build",
    "test": "bun test --isolate ./test",
    "lint": "bun ./node_modules/eslint/bin/eslint.js .",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "bun ./node_modules/prettier/bin/prettier.cjs --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "axios": "^1.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.0",
    "react-toastify": "^11.0.0",
    "tailwindcss": "^4.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "prettier": "^3.6.2"
  }
}

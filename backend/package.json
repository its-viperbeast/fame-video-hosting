{
  "name": "frame-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "typecheck": "tsc --noEmit",
    "test:delete-live": "bun scripts/check-delete-flow.ts",
    "password": "bun scripts/hash-password.ts",
    "normalize-names": "bun scripts/normalize-video-names.ts",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "bun ./node_modules/prettier/bin/prettier.cjs --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}

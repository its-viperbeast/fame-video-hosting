NODE_ENV=development
PORT=9090
MONGODB_URI=mongodb://127.0.0.1:27017/video-manager
# Backblaze B2 bucket region. The endpoint host must be s3.<region>.backblazeb2.com.
AWS_REGION=us-west-004
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
AWS_S3_BUCKET=your-b2-bucket
# Application key ID and application key, restricted to this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# First start copies these into the admins collection. Sign-in then uses that record.
AUTH_EMAIL=admin@example.com
# Generate with bun run password (interactive, input is hidden).
AUTH_PASSWORD_HASH=
MAX_UPLOAD_BYTES=2147483648
# Custom thumbnail images; every thumbnail is stored as a 1920x1080 WebP.
MAX_THUMBNAIL_BYTES=10485760
PRESIGNED_URL_TTL_SECONDS=900
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Optional public origin that serves bucket objects as <origin>/<object key>,
# e.g. Cloudflare in front of B2. Playback and thumbnails then use it; links are
# public and do not expire. Leave empty for short-lived signed URLs.
MEDIA_BASE_URL=
FFMPEG_PATH=ffmpeg
# pipe:0 and pipe:1 are replaced with seekable temp files so +faststart can run.
FFMPEG_ARGS=-hide_banner -nostdin -i pipe:0 -map 0:V -map 0:a? -map 0:s? -c copy -movflags +faststart -f mp4 -y pipe:1
